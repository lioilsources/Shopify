# --- Databáze ---
# Dev DB on JODA, see infra/joda/README.md (password only in .env)
DATABASE_URL=postgresql+psycopg://chatshop:CHANGE_ME@JODA_HOST:5436/chatshop_dev
# Integration tests (pytest -m db) wipe this database
TEST_DATABASE_URL=postgresql+psycopg://chatshop:CHANGE_ME@JODA_HOST:5436/chatshop_test

# --- LLM přes AiStack gateway na DGX Sparku (OpenAI-compatible) ---
# Gateway (:8080) routuje přes LiteLLM podle `model` — chat i embeddings.
# Z LAN: http://<SPARK_HOST>:8080/v1, veřejně: https://llm.ol1n.com/v1
# Nechej prázdné pro mock režim (chat funguje bez LLM).
LLM_BASE_URL=
# LLM_BASE_URL=http://<SPARK_HOST>:8080/v1
LLM_MODEL=shop
LLM_API_KEY=not-needed

# --- Embeddings (BAAI/bge-m3, 1024 dim — přes tutéž gateway) ---
# Nechej prázdné pro mock embeddingy (deterministický hash-vektor).
# Po přepnutí mock -> reálný model: python -m brain.seed --reembed
EMBEDDINGS_BASE_URL=
# EMBEDDINGS_BASE_URL=http://<SPARK_HOST>:8080/v1
EMBEDDINGS_MODEL=shop-embed
# Short timeout: when SPARK is busy, search falls back to fulltext
EMBEDDINGS_TIMEOUT=5

# --- Web BFF -> brain ---
BRAIN_URL=http://localhost:8000

# --- Admin (ingest, schvalování) ---
# Shared secret brain <-> web BFF; never reaches the browser. Without it admin is closed.
ADMIN_TOKEN=

# FineTuneGallery shop export (Prompts/05-PLAN-curation.md, docs/GALLERY_EXPORT.md)
# Own read-only token and own CF Access service token; never the gallery WORKER_TOKEN.
GALLERY_URL=https://gallery.example.com
GALLERY_COLLECTION=shop
GALLERY_EXPORT_TOKEN=
GALLERY_CF_CLIENT_ID=
GALLERY_CF_CLIENT_SECRET=
# Private originals; defaults to run/media in the repo (gitignored)
# MEDIA_DIR=
