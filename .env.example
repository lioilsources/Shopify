# --- Databáze ---
DATABASE_URL=postgresql+psycopg://chatshop:chatshop@localhost:5432/chatshop

# --- LLM (vLLM na DGX Spark, OpenAI-compatible) ---
# Nechej prázdné pro mock režim (chat funguje bez LLM).
LLM_BASE_URL=
# LLM_BASE_URL=http://spark.local:8001/v1
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_API_KEY=not-needed

# --- Embeddings (TEI na DGX Spark) ---
# Nechej prázdné pro mock embeddingy (deterministický hash-vektor).
EMBEDDINGS_BASE_URL=
# EMBEDDINGS_BASE_URL=http://spark.local:8002
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Web BFF -> brain ---
BRAIN_URL=http://localhost:8000
