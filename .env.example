# --- Databáze ---
DATABASE_URL=postgresql+psycopg://chatshop:chatshop@localhost:5432/chatshop

# --- LLM přes AiStack gateway na DGX Sparku (OpenAI-compatible) ---
# Gateway (:8080) routuje přes LiteLLM podle `model` — chat i embeddings.
# Z LAN: http://<SPARK_HOST>:8080/v1, veřejně: https://llm.ol1n.com/v1
# Nechej prázdné pro mock režim (chat funguje bez LLM).
LLM_BASE_URL=
# LLM_BASE_URL=http://<SPARK_HOST>:8080/v1
LLM_MODEL=shop
LLM_API_KEY=not-needed

# --- Embeddings (BAAI/bge-m3, 1024 dim — přes tutéž gateway) ---
# Nechej prázdné pro mock embeddingy (deterministický hash-vektor).
# Po přepnutí mock -> reálný model: python -m brain.seed --reembed
EMBEDDINGS_BASE_URL=
# EMBEDDINGS_BASE_URL=http://<SPARK_HOST>:8080/v1
EMBEDDINGS_MODEL=shop-embed

# --- Web BFF -> brain ---
BRAIN_URL=http://localhost:8000
